# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB Atlas SRV URI in production, local MongoDB for development.
MONGODB_URI="mongodb://127.0.0.1:27017/employee_management"

# HS256 signing key. Must be at least 32 characters.
JWT_SECRET="replace-with-a-random-32-character-secret"

# 30m / 12h / 7d
JWT_EXPIRES_IN="7d"

# Seeded admin account (used by `npm run create-admin`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345"
ADMIN_USERNAME="admin"

# development | test | production
NODE_ENV="development"

NEXT_PUBLIC_APP_NAME="Employee Management"
